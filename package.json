        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "bun-types": "^1.4.4",
        "gt": "^2.26.6",
        "knip": "^6.42.1",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "react-email": "^6.11.3",
        "shadcn": "^4.22.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
