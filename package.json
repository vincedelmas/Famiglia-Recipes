{
    "name": "famiglia-recipes",
    "private": true,
    "type": "module",
    "browserslist": [
        ">0.3%, defaults, supports es6-module"
    ],
    "scripts": {
        "lint": "oxlint",
        "knip": "knip-bun",
        "dk": "drizzle-kit",
        "ui": "bunx shadcn@latest",
        "i18n:generate": "gt generate",
        "i18n:validate": "gt validate",
        "build": "bun --bun vite build",
        "preview": "bun --bun vite preview",
        "dev": "bun --bun vite dev --port 3000",
        "key:generate": "bun run src/lib/utils/hash-key.ts",
        "email": "email dev -d src/lib/client/components/emails",
        "auth:generate": "bunx @better-auth/cli@latest generate --y --output src/lib/server/database/schema/auth.schema2.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@hookform/resolvers": "^5.9.2",
        "@libsql/client": "^0.18.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.1",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-router": "1.170.41",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.168.60",
        "better-auth": "^1.7.12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4",
        "gt-react": "^11.4.14",
        "lucide-react": "^1.61.0",
        "mammoth": "^1.13.0",
        "nodemailer": "^10.2.1",
        "nprogress": "^0.2.0",
        "pino": "^10.4.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-easy-crop": "^6.2.4",
        "react-hook-form": "^7.90.0",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.0.9",
        "@generaltranslation/compiler": "^1.3.64",
        "@react-email/ui": "6.9.5",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.104.5",
        "@types/babel__core": "^7.20.5",
